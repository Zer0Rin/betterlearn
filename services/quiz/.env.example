# Copied once to <home>/quiz.env; reinstall/upgrade preserves your edits.
# Set these before first start. Never commit credentials.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=betterlearn
MYSQL_PASSWORD=
MYSQL_DATABASE=betterlearn_quiz
MYSQL_CHARSET=utf8mb4
MYSQL_POOL_MINSIZE=1
MYSQL_POOL_MAXSIZE=10
MYSQL_AUTO_INIT=true
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=43200
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
TAVILY_API_KEY=
ENABLE_WEB_SEARCH=true
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_IMAGE_MODEL=qwen-image-2.0
DASHSCOPE_IMAGE_API_KEY=
DASHSCOPE_IMAGE_BASE_URL=
IMAGE_GEN_SIZE=512*512
IMAGE_GEN_DAILY_LIMIT=20
IMAGE_GEN_MAX_CONCURRENCY=5
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=
COS_BUCKET=
COS_UPLOAD_PREFIX=quiz-images/
COS_DOMAIN=
# Host supplies absolute upload/vector paths beneath quizDataRoot.
KB_MAX_DOCUMENTS_PER_USER=10
KB_MAX_FILE_SIZE_MB=10
KB_CHUNK_SIZE=1000
KB_CHUNK_OVERLAP=150
KB_RETRIEVE_TOP_K=4
APP_DEBUG=false
LOCAL_LOGIN_ENABLED=false
LOG_LEVEL=INFO
